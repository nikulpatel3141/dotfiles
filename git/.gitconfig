[user]
	email = nikulpatel3141@users.noreply.github.com
	name = Nikul Patel

[credential "https://github.com"]
	helper = 
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate    = true   # n / N to jump between diff sections
	side-by-side = true
	line-numbers = true

[diff]
	colorMoved = default

[merge]
	conflictstyle = diff3

[alias]
	st      = status -sb                              # short status with branch
	co      = checkout
	br      = branch -vv                              # branches with tracking info
	lg      = log --oneline --graph --decorate --all  # pretty graph of all branches
	last    = log -1 HEAD --stat                      # last commit + files changed
	unstage = restore --staged                        # unstage a file
	aliases = config --get-regexp alias               # list all aliases

[pull]
	rebase = false
